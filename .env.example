# Shlink Dashboard configuration. Copy to .env and fill in.

# Database. Drivers: mysql, mariadb, postgres, mssql, sqlite
# Host: use 127.0.0.1 when running the dev server directly (npm),
# or host.docker.internal when running locally via docker compose.
SHLINK_DASHBOARD_DB_DRIVER=mysql
SHLINK_DASHBOARD_DB_HOST=127.0.0.1
SHLINK_DASHBOARD_DB_PORT=3306
SHLINK_DASHBOARD_DB_NAME=shlink_dashboard
SHLINK_DASHBOARD_DB_USER=
SHLINK_DASHBOARD_DB_PASSWORD=
SHLINK_DASHBOARD_DB_USE_ENCRYPTION=false

# Comma-separated list of long random strings used to sign sessions.
# Generate one with: openssl rand -hex 32
SHLINK_DASHBOARD_SESSION_SECRETS=

# HTTP port the server listens on
SHLINK_DASHBOARD_PORT=3005

# Reverse proxies trusted to set X-Forwarded-* headers (comma-separated IPs, subnets, or keywords like loopback or
# uniquelocal). Needed behind an HTTPS proxy, or logging in fails with "Bad Request". Defaults to loopback.
#SHLINK_DASHBOARD_TRUSTED_PROXIES=loopback
