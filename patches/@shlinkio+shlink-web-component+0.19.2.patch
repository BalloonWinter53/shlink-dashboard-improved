+import { Context, FC, ReactNode } from 'react';
+import { ShlinkShortUrl } from '../api-contract';
+export type ShortUrlsTableExtraColumnCellProps = {
+    shortUrl: ShlinkShortUrl;
+    /** Whether bot visits should be excluded, as resolved by the table from settings and query params */
+    excludeBots: boolean;
+};
+export type ShortUrlsTableExtraColumn = {
+    key: string;
+    /** Used as header (unless `header` is provided) and as the cell label on small screens */
+    name: string;
+    header?: ReactNode;
+    className?: string;
+    /** Order field to sort the table by this column. Shlink does not know it, so the API client needs to handle it */
+    orderField?: string;
+    Cell: FC<ShortUrlsTableExtraColumnCellProps>;
+};
+/** Lets consumers append extra columns to the short URLs table (shlink-dashboard patch) */
+export declare const ShortUrlsTableExtraColumnsContext: Context<ShortUrlsTableExtraColumn[]>;
